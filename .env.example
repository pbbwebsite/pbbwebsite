# GitHub repository yang menjadi sumber konten CMS
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Gunakan kata sandi administrator yang kuat dan secret acak panjang (minimal 32 byte)
CMS_ADMIN_PASSWORD=
CMS_SESSION_SECRET=
# Password khusus untuk data organisasi; minimal 16 karakter, berbeda dari password CMS
PLATFORM_ADMIN_PASSWORD=

# Opsional: endpoint HTTPS milik layanan penerima formulir yang menerima JSON
CONTACT_WEBHOOK_URL=

# Opsional: untuk menampilkan status deployment Netlify di dashboard
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Supabase (SERVER ONLY — never expose this key to browser/client code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ticketing (keep secrets server-side only; leave disabled until all checks pass)
TICKETING_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_QRIS_ACQUIRER=gopay
RESEND_API_KEY=
TICKET_EMAIL_FROM=Persatuan Boxing Bogor <tiket@domain-anda.id>
